# Gmail SMTP example. Use a Gmail App Password, not your normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-dossier-sender@gmail.com
MAIL_PASSWORD=your-16-character-app-password
COMPANY_EMAIL=your-admin-inbox@example.com

# Required in production
DOSSIER_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@dossier.app
ADMIN_PASSWORD=admin@123