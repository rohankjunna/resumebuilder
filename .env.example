# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
DOSSIER_SECRET_KEY=replace-with-a-long-random-secret

# Admin credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password

# Gmail SMTP — use a Gmail App Password (not your normal password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-16-character-app-password
COMPANY_EMAIL=your-admin-inbox@gmail.com

# Fast2SMS — Indian SMS OTP (get key at fast2sms.com)
FAST2SMS_API_KEY=your-fast2sms-api-key
